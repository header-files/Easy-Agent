{
  "name": "easy-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Easy Agent 本地 CLI、多模型装配与统一应用服务",
  "type": "module",
  "bin": {
    "easy-agent": "dist/application/cli/bin.js"
  },
  "engines": {
    "node": ">=26.0.0 <27"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/header-files/Easy-Agent.git"
  },
  "scripts": {
    "chat": "node src/application/cli/bin.ts chat",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "build": "tsc -p tsconfig.build.json",
    "pretest": "npm run build",
    "test": "node --test tests/*.test.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.6",
    "eslint": "10.15.0",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "pino": "10.4.0"
  }
}

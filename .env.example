# Export these in your shell; Easy Agent does not automatically load .env files.
EASY_AGENT_MODEL=example-model
EASY_AGENT_BASE_URL=http://localhost:1234/v1
# OPENAI_API_KEY is optional for unauthenticated local providers.
# OPENAI_API_KEY=replace-locally
EASY_AGENT_MAX_MODEL_RETRIES=2
EASY_AGENT_STREAM=true
LOG_LEVEL=info
